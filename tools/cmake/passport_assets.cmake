# Optional machine-local settings select private artwork without committing it.
if(NOT DEFINED PASSPORT_SOURCE_ROOT)
    get_filename_component(PASSPORT_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
if(NOT DEFINED PASSPORT_USE_LOCAL_ASSETS)
    set(PASSPORT_USE_LOCAL_ASSETS ON)
endif()
set(PASSPORT_ASSETS "${PASSPORT_SOURCE_ROOT}/assets")
set(_required_scenes 0)
if(PASSPORT_USE_LOCAL_ASSETS AND NOT CMAKE_SCRIPT_MODE_FILE)
    # Track creation/removal as well as edits, including when the local file is
    # initially absent. Ninja rechecks the glob before an incremental build.
    file(GLOB _personal_settings CONFIGURE_DEPENDS "${PASSPORT_SOURCE_ROOT}/private/passport-build.json")
endif()
if(PASSPORT_USE_LOCAL_ASSETS AND EXISTS "${PASSPORT_SOURCE_ROOT}/private/passport-build.json")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${PASSPORT_SOURCE_ROOT}/private/passport-build.json")
    endif()
    file(READ "${PASSPORT_SOURCE_ROOT}/private/passport-build.json" _local_options)
    string(JSON _required_scenes GET "${_local_options}" required_motion_scenes)
    if(NOT PASSPORT_PRIVATE_ASSETS_DIR)
        string(JSON PASSPORT_PRIVATE_ASSETS_DIR GET "${_local_options}" asset_dir)
    endif()
endif()
if(PASSPORT_PRIVATE_ASSETS_DIR)
    get_filename_component(PASSPORT_ASSETS "${PASSPORT_PRIVATE_ASSETS_DIR}" ABSOLUTE BASE_DIR "${PASSPORT_SOURCE_ROOT}")
endif()
set(PASSPORT_MOTION "${PASSPORT_ASSETS}/images/passport_motion.c")
if(_required_scenes GREATER 0)
    if(NOT EXISTS "${PASSPORT_MOTION}" OR NOT EXISTS "${PASSPORT_ASSETS}/passport/motion-manifest.json")
        message(FATAL_ERROR "Required motion assets missing; regenerate personal assets before building.")
    endif()
    file(READ "${PASSPORT_ASSETS}/passport/motion-manifest.json" _motion_manifest)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${PASSPORT_ASSETS}/passport/motion-manifest.json" "${PASSPORT_MOTION}")
    endif()
    string(JSON _motion_frames ERROR_VARIABLE _frames_error GET "${_motion_manifest}" frame_count)
    string(JSON _motion_scenes ERROR_VARIABLE _scenes_error GET "${_motion_manifest}" scene_count)
    string(JSON _expected_motion_sha ERROR_VARIABLE _sha_error GET "${_motion_manifest}" source_sha256)
    if(_frames_error OR _scenes_error OR _sha_error OR NOT _motion_frames EQUAL 18 OR _motion_scenes LESS _required_scenes)
        message(FATAL_ERROR "Required motion scenes incomplete; regenerate personal assets before building.")
    endif()
    file(SHA256 "${PASSPORT_MOTION}" _actual_motion_sha)
    if(NOT _actual_motion_sha STREQUAL _expected_motion_sha)
        message(FATAL_ERROR "Required motion source checksum mismatch; regenerate personal assets.")
    endif()
endif()
if(NOT EXISTS "${PASSPORT_MOTION}")
    set(PASSPORT_MOTION "${PASSPORT_SOURCE_ROOT}/assets/images/passport_motion.c")
endif()
set(PASSPORT_BOLD_FONT "${PASSPORT_SOURCE_ROOT}/assets/fonts/passport_font_24_bold.c")
set(_bold_manifest "${PASSPORT_SOURCE_ROOT}/assets/passport/bold-font-manifest.json")
if(EXISTS "${PASSPORT_ASSETS}/fonts/passport_font_24_bold.c")
    set(PASSPORT_BOLD_FONT "${PASSPORT_ASSETS}/fonts/passport_font_24_bold.c")
    set(_bold_manifest "${PASSPORT_ASSETS}/passport/bold-font-manifest.json")
endif()
if(EXISTS "${PASSPORT_BOLD_FONT}")
    file(READ "${_bold_manifest}" _bold_data)
    string(JSON _bold_sha GET "${_bold_data}" source_sha256)
    file(SHA256 "${PASSPORT_BOLD_FONT}" _bold_actual)
    if(NOT _bold_sha STREQUAL _bold_actual)
        message(FATAL_ERROR "Badge bold font checksum mismatch; regenerate the font.")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bold_manifest}" "${PASSPORT_BOLD_FONT}")
    endif()
endif()
set(PASSPORT_AGENT_AVATAR "${PASSPORT_SOURCE_ROOT}/assets/images/passport_agent_avatar.c")
if(DEFINED _local_options)
    string(JSON _require_agent ERROR_VARIABLE _agent_option_error GET "${_local_options}" required_agent_avatar)
    if(NOT _agent_option_error AND _require_agent AND NOT EXISTS "${PASSPORT_ASSETS}/images/passport_agent_avatar.c")
        message(FATAL_ERROR "Required Nora avatar missing; run build_passport_agent_avatar.py.")
    endif()
endif()
if(PASSPORT_USE_LOCAL_ASSETS AND EXISTS "${PASSPORT_ASSETS}/images/passport_agent_avatar.c")
    set(PASSPORT_AGENT_AVATAR "${PASSPORT_ASSETS}/images/passport_agent_avatar.c")
    file(READ "${PASSPORT_ASSETS}/passport/agent-avatar-manifest.json" _agent_manifest)
    string(JSON _agent_sha GET "${_agent_manifest}" source_sha256)
    string(JSON _agent_count GET "${_agent_manifest}" frame_count)
    string(JSON _agent_width GET "${_agent_manifest}" width)
    string(JSON _agent_height GET "${_agent_manifest}" height)
    if(NOT _agent_count EQUAL 8 OR NOT _agent_width EQUAL 128 OR NOT _agent_height EQUAL 132)
        message(FATAL_ERROR "Invalid Nora character frame format.")
    endif()
    file(SHA256 "${PASSPORT_AGENT_AVATAR}" _agent_actual)
    if(NOT _agent_sha STREQUAL _agent_actual)
        message(FATAL_ERROR "Muse character checksum mismatch; regenerate Nora assets.")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${PASSPORT_ASSETS}/passport/agent-avatar-manifest.json" "${PASSPORT_AGENT_AVATAR}")
    endif()
endif()
